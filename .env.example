# Server (apps/server reads this root .env locally; set the same names on Railway)
PORT=8787
DATABASE_URL=
DEMO_PASSCODE=

# Stellar Testnet secret keys (S...), created by the setup script (#2)
OWNER_SECRET=
AGENT_SECRET=
SSS_AGENCY_SECRET=
PHILHEALTH_AGENCY_SECRET=
PAGIBIG_AGENCY_SECRET=

# Velo (velo-build.dev dashboard, Testnet)
VELO_API_KEY=
VELO_WEBHOOK_SECRET=

# Velo Gas Station (stretch: sponsor owner-signed Noir transactions on Testnet)
USE_GAS_STATION=false
VELO_GAS_API_KEY=
VELO_GAS_BASE_URL=https://www.velo-build.dev

# Gemini (free key: aistudio.google.com). Without it the agent uses its fallback rules.
GEMINI_API_KEY=
# Optional; default gemini-3.5-flash
GEMINI_MODEL=

# PHP value of 1 XLM, used to show amounts in PHP (e.g. 15.00)
XLM_PHP_RATE=

# Public web URL, for Velo checkout success/cancel redirects (default http://localhost:3000)
WEB_URL=

# Web (set on Vercel; defaults to http://localhost:8787 locally)
NEXT_PUBLIC_SERVER_URL=
# Same value as DEMO_PASSCODE, for the login page's "Use Demo Account" button (visible in the browser bundle)
NEXT_PUBLIC_DEMO_PASSCODE=
