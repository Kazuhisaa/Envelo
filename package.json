{
  "name": "envelo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @envelo/server --filter @envelo/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @envelo/server start",
    "test": "vitest run --no-file-parallelism",
    "lint": "pnpm -r lint",
    "setup:testnet": "pnpm --filter @envelo/server setup:testnet",
    "reset:envelopes": "pnpm --filter @envelo/server reset:envelopes",
    "check:ai": "pnpm --filter @envelo/server check:ai"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
